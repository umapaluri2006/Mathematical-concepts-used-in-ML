# -----------------------------------
# 1️⃣ Basic Function Example
# -----------------------------------

def f(x):
    return 2*x + 3

print("f(1) =", f(1))


# -----------------------------------
# 2️⃣ Important Types of Functions
# -----------------------------------

import math

# Linear Function
def linear(x):
    return 3*x + 2   # y = mx + c

# Quadratic Function
def quadratic(x):
    return 2*(x**2) + 3*x + 1   # y = ax^2 + bx + c

# Exponential Function
def exponential(x):
    return math.exp(x)   # y = e^x

# Logarithmic Function
def logarithmic(x):
    return math.log(x)   # y = log(x)


print("Linear f(5) =", linear(5))
print("Quadratic f(2) =", quadratic(2))
print("Exponential f(1) =", exponential(1))
print("Logarithmic f(10) =", logarithmic(10))


