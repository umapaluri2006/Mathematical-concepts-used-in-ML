"""
Day 4 – From Line to Real Linear Regression
------------------------------------------

We know the equation:

y = mx + c

Big Question:
How do we find the best m and c for real data?

That is where Machine Learning begins.
"""

# -----------------------------------
# 1️⃣ Real Data
# -----------------------------------

import numpy as np

# Hours studied (x)
x = np.array([1, 2, 3, 4])

# Marks scored (y)
y = np.array([50, 60, 65, 80])

print("Hours:", x)
print("Marks:", y)
print("-" * 40)


# -----------------------------------
# 2️⃣ Prediction Formula
# -----------------------------------
"""
Prediction formula:

ŷ = mx + c

This gives predicted values.
"""

# Assume some random m and c (initial guess)
m = 5
c = 40

y_pred = m * x + c

print("Predicted values:", y_pred)
print("-" * 40)


# -----------------------------------
# 3️⃣ Error Calculation
# -----------------------------------
"""
Error = Actual - Predicted
"""

error = y - y_pred

print("Errors:", error)
print("-" * 40)


# -----------------------------------
# 4️⃣ Squared Error
# -----------------------------------
"""
Squared Error = (y - ŷ)^2

Why square?
- Makes all errors positive
- Penalizes large mistakes more
"""

squared_error = error ** 2

print("Squared Errors:", squared_error)
print("-" * 40)


# -----------------------------------
# 5️⃣ Cost Function (Mean Squared Error)
# -----------------------------------
"""
Cost Function:

J(m, c) = (1/n) * Σ (y - ŷ)^2

Goal:
Find m and c that minimize this cost.
"""

mse = np.mean(squared_error)

print("Mean Squared Error (Cost):", mse)
print("-" * 40)


print("""
Conclusion:

Linear Regression tries different values of m and c
to minimize the Cost Function (MSE).

Lower cost = Better fitting line.
""")
